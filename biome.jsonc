{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!.next",
			"!next-env.d.ts",
			// Generated by `npm run types:gen` — regenerating would undo any edits.
			"!types/supabase.ts",
			// Scratch state written by `supabase start`, including edge-runtime
			// bootstrap code that is not ours to lint.
			"!supabase/.temp",
			// Go text/template email bodies, not plain HTML: the `{{ ... }}`
			// interpolation is not something Biome's HTML parser accepts.
			"!supabase/templates",
			// Static image assets, not source: the a11y rules Biome applies to
			// standalone `.svg` files do not apply to them.
			"!public"
		]
	},
	// Biome is used here as a linter only, standing in for ESLint. Formatting
	// stays out of scope: enable `formatter` to opt in, which will rewrite
	// every file in the repo.
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"css": {
		// `@theme`, `@custom-variant`, `@apply` in app/globals.css (Tailwind v4).
		"parser": { "tailwindDirectives": true }
	},
	"linter": {
		"enabled": true,
		// The rough equivalent of `eslint-config-next`: the Next.js and React
		// rule sets, on top of Biome's own recommended preset.
		"domains": { "next": "recommended", "react": "recommended" },
		"rules": { "preset": "recommended" }
	},
	"overrides": [
		{
			// The form-field wrappers accept `UseFormReturn<any>` on purpose: they are
			// generic over every form shape in the app, and threading a type parameter
			// through each one buys no real safety at the call sites.
			"includes": ["components/form-fields/**/*.tsx", "**/*.d.ts"],
			"linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
		}
	]
}
